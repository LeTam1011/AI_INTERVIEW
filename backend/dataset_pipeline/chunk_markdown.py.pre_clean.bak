
import json
import re
from pathlib import Path


BASE_DIR = Path(__file__).resolve().parent
RAW_DIR = BASE_DIR / "data" / "raw"
CHUNK_DIR = BASE_DIR / "data" / "chunk"

# Supports:
# 1. ### What is Python?
# ### Q1. What is Python?
# ### Question 1: What is Python?
# ### What is Python?
QUESTION_HEADING = re.compile(
    r"^\s*(?:"
    r"\d+\s*[\.)]\s*#{1,6}\s*"
    r"|#{1,6}\s*(?:(?:Q|Question)\s*\d+\s*[\.:)\-]?\s*)?"
    r")(.+?)\s*$",
    re.IGNORECASE,
)

DIFFICULTY_PATTERN = re.compile(
    r"^\s*(?:\*\*)?Difficulty(?:\*\*)?\s*:\s*"
    r"(Easy|Medium|Hard)\b",
    re.IGNORECASE | re.MULTILINE,
)


def detect_topic(filename: str) -> str:
    # Ánh xạ tường minh để tránh tên chủ đề bị rút gọn sai.
    topic_map = {
        "da_interview_question": "Data Analytics",
        "docker_interview.question": "Docker",
        "git_interview_question": "Git",
        "java_interview_question": "Java",
        "javascript_interview_question": "JavaScript",
        "ml_interview_question": "Machine Learning",
        "nodejs_interview_question": "Node.js",
        "oop_interview_question": "Object-Oriented Programming",
        "python_interview_question": "Python",
        "react_interview_question": "React",
        "sd_interview_question": "System Design",
        "spring_interview_question": "Spring",
        "sql_interview_question": "SQL",
    }

    return topic_map.get(
        Path(filename).stem.lower(),
        Path(filename).stem.replace("_", " ").title(),
    )


QUESTION_HEADING = re.compile(
    r"^\s*(?:"
    r"\d+\s*[\.)]\s*(?:#{1,6}\s*)?"
    r"|#{1,6}\s*(?:(?:Q|Question)\s*\d+\s*[\.:)\-]?\s*)?"
    r")(.+?)\s*$",
    re.IGNORECASE,
)

QUESTION_START = re.compile(
    r"^(?:"
    r"what|why|how|when|where|which|who|whom|whose|"
    r"can|could|would|should|will|is|are|was|were|"
    r"do|does|did|has|have|had|"
    r"define|explain|describe|discuss|compare|"
    r"differentiate|distinguish|list|name|identify|"
    r"mention|tell|give|write|implement|"
    r"calculate|find|state|outline|"
    r"định nghĩa|giải thích|mô tả|so sánh|"
    r"nêu|trình bày|liệt kê"
    r")\b",
    re.IGNORECASE,
)


def is_question_heading(line: str) -> bool:
    """
    Chỉ nhận diện tiêu đề câu hỏi có cấu trúc rõ ràng,
    tránh biến các dòng trong phần đáp án thành câu hỏi.
    """
    stripped = line.strip()

    if not stripped:
        return False

    # Loại bỏ nội dung nằm trong code block hoặc dòng thụt lề
    # để tránh nhận diện nhầm danh sách bên trong đáp án.
    if line.startswith(("    ", "\t")):
        return False

    match = QUESTION_HEADING.match(stripped)

    if not match:
        return False

    title = match.group(1).strip()

    if not title:
        return False

    if re.search(
        r"\binterview\s+questions?\b",
        title,
        re.IGNORECASE,
    ):
        return False

    # Loại tiêu đề chỉ là số thứ tự hoặc danh sách.
    if re.fullmatch(r"[\d\s.)-]+", title):
        return False

    # Tiêu đề Markdown có cấp heading được ưu tiên.
    has_markdown_heading = bool(
        re.match(r"^\s*(?:\d+\s*[\.)]\s*)?#{1,6}\s+", stripped)
    )

    if has_markdown_heading:
        return (
            title.endswith("?")
            or bool(QUESTION_START.match(title))
        )

    # Với dòng không có Markdown heading, bắt buộc phải có
    # số thứ tự và có dạng câu hỏi rõ ràng.
    has_number = bool(
        re.match(r"^\s*\d+\s*[\.)]\s+", stripped)
    )

    return (
        has_number
        and (
            title.endswith("?")
            or bool(QUESTION_START.match(title))
        )
    )


def extract_question(section: str) -> str:
    for line in section.splitlines():
        match = QUESTION_HEADING.match(line)

        if match and is_question_heading(line):
            return match.group(1).strip()

    return ""


def split_question_sections(markdown: str) -> list[str]:
    lines = markdown.replace("\r\n", "\n").split("\n")

    # Chuẩn hóa dạng:
    # 2.
    # ### Define the term ...
    # thành:
    # 2. ### Define the term ...
    normalized_lines = []
    i = 0

    while i < len(lines):
        current = lines[i]

        if (
            re.match(r"^\s*\d+\s*[\.)]\s*$", current)
            and i + 1 < len(lines)
            and re.match(r"^\s*#{1,6}\s+", lines[i + 1])
        ):
            current = current.rstrip() + " " + lines[i + 1].strip()
            i += 1

        normalized_lines.append(current)
        i += 1

    sections = []
    current_section = []

    for line in normalized_lines:
        if is_question_heading(line):
            if current_section:
                section = "\n".join(current_section).strip()
                if extract_question(section):
                    sections.append(section)

            current_section = [line]

        elif current_section:
            current_section.append(line)

    if current_section:
        section = "\n".join(current_section).strip()
        if extract_question(section):
            sections.append(section)

    return sections


def extract_answer(section: str) -> str:
    lines = section.splitlines()

    # Bỏ tiêu đề câu hỏi đầu tiên.
    heading_index = None

    for i, line in enumerate(lines):
        if is_question_heading(line):
            heading_index = i
            break

    if heading_index is None:
        return ""

    text = "\n".join(lines[heading_index + 1:]).strip()

    # Bỏ nhãn Answer: nếu có.
    text = re.sub(
        r"^\s*(?:\*\*)?Answer(?:\*\*)?\s*:?\s*",
        "",
        text,
        count=1,
        flags=re.IGNORECASE,
    )

    return text.strip()




def process_file(path: Path) -> list[dict]:
    markdown = path.read_text(encoding="utf-8-sig")
    sections = split_question_sections(markdown)
    chunks = []
    topic = detect_topic(path.name)

    for index, section in enumerate(sections, start=1):
        question = extract_question(section)

        if not question:
            continue

        answer = extract_answer(section)
        difficulty_match = DIFFICULTY_PATTERN.search(section)

        difficulty = (
            difficulty_match.group(1).title()
            if difficulty_match
            else "Unknown"
        )

        answer_status = "available" if answer.strip() else "pending"

        content = f"Question: {question}"
        if answer.strip():
            content += f"\n\nAnswer: {answer}"

        chunks.append({
            "id": f"{path.stem}-{index:04d}",
            "content": content,
            "question": question,
            "answer": answer,
            "metadata": {
                "topic": topic,
                "difficulty": difficulty,
                "type": "technical",
                "source": path.name,
                "answer_status": answer_status,
            },
        })

    
    # Loại câu hỏi trùng trong cùng file.
    # Giữ một chunk cho mỗi câu hỏi; hợp nhất các đáp án khác nhau.
    unique_chunks = {}

    for chunk in chunks:
        normalized = chunk["question"].lower().strip()
        normalized = re.sub(r"\s+", " ", normalized)
        normalized = re.sub(r"[^\w\s]", "", normalized)

        if not normalized:
            continue

        existing = unique_chunks.get(normalized)

        if existing is None:
            unique_chunks[normalized] = chunk
            continue

        old_answer = existing["answer"].strip()
        new_answer = chunk["answer"].strip()

        if not new_answer:
            continue

        if not old_answer:
            existing["answer"] = new_answer
            existing["content"] = (
                f'Question: {existing["question"]}\n\n'
                f'Answer: {new_answer}'
            )
            existing["metadata"]["answer_status"] = "available"
            continue

        # Không nối thêm nếu hai đáp án giống nhau.
        if new_answer.casefold() == old_answer.casefold():
            continue

        # Gộp đáp án khác nhau, tránh lặp lại nguyên văn.
        old_sentences = {
            re.sub(r"\s+", " ", sentence.strip()).casefold()
            for sentence in re.split(r"(?<=[.!?])\s+", old_answer)
            if sentence.strip()
        }

        additional_sentences = []
        for sentence in re.split(r"(?<=[.!?])\s+", new_answer):
            sentence = sentence.strip()
            if not sentence:
                continue

            normalized_sentence = re.sub(
                r"\s+", " ", sentence
            ).casefold()

            if normalized_sentence not in old_sentences:
                additional_sentences.append(sentence)
                old_sentences.add(normalized_sentence)

        if additional_sentences:
            existing["answer"] = (
                old_answer + "\n\n" + " ".join(additional_sentences)
            )
            existing["content"] = (
                f'Question: {existing["question"]}\n\n'
                f'Answer: {existing["answer"]}'
            )

    return list(unique_chunks.values())





def main():
    CHUNK_DIR.mkdir(parents=True, exist_ok=True)
    files = sorted(
        path for path in RAW_DIR.glob("*.md")
        if ".cleaned_test" not in path.stem.lower()
    )

    if not files:
        print(f"No Markdown files found in: {RAW_DIR}")
        return

    total = 0

    for path in files:
        chunks = process_file(path)
        output_path = CHUNK_DIR / f"chunked_{path.stem}.json"

        output_path.write_text(
            json.dumps(chunks, ensure_ascii=False, indent=2),
            encoding="utf-8",
        )

        total += len(chunks)
        print(
            f"{path.name}: {len(chunks)} chunks "
            f"-> {output_path.name}"
        )

        if not chunks:
            print(
                "  WARNING: No questions detected. "
                "Check this file's Markdown format."
            )

    print(f"\nDone. Processed {len(files)} files and {total} chunks.")


if __name__ == "__main__":
    main()
